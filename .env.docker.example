# Docker Compose — copie para .env na raiz do repositório
# cp .env.docker.example .env

# Diretório no HOST onde o SQLite será persistido (bind mount)
WFRP_DATA_DIR=/opt/wfrp-solo/data

# Portas expostas no host (127.0.0.1 = só localhost; nginx no host faz proxy)
BACKEND_BIND=127.0.0.1:8000
FRONTEND_BIND=127.0.0.1:3000

# --- Backend ---
APP_ENV=production

JWT_SECRET=change-me-use-long-random-string-in-production
JWT_EXPIRE_DAYS=7

AUTH_MODE=fixed_admin
ADMIN_PASSWORD=change-me-min-8-chars

EMAIL_PROVIDER=mock

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell

API_BASE_URL=https://api.rpg.seudominio.com
CORS_ORIGINS=https://rpg.seudominio.com

ENABLE_CUSTOM_CHARGEN=false

# --- Frontend (build-time args) ---
NEXT_PUBLIC_API_URL=https://api.rpg.seudominio.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_CUSTOM_CHARGEN=false
