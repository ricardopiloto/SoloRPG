# Backend — copie para backend/.env

# Perfil de banco: sqlite-dev | postgres | supabase
# Default sqlite-dev — funciona sem Docker
DATABASE_PROFILE=sqlite-dev

# Sobrescreve o perfil quando definido:
# DATABASE_URL=postgresql+asyncpg://wfrp:wfrp@localhost:5432/wfrp_solo
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Perfil postgres (Docker/Podman) ---
# DATABASE_PROFILE=postgres
# docker compose up -d   # ou: podman compose up -d

# --- Perfil supabase (cloud) ---
# DATABASE_PROFILE=supabase
# DATABASE_URL=postgresql+asyncpg://...

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Para testes locais sem API:
# LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Frontend — copie para frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
