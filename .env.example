# Backend — copie para backend/.env

# SQLite (único backend suportado)
DATABASE_URL=sqlite+aiosqlite:///./wfrp_solo.db

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Para testes locais sem API:
# LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Autenticação (JWT)
JWT_SECRET=change-me-use-long-random-string-in-production
JWT_EXPIRE_DAYS=7

# Fase 1: conta única admin (default)
AUTH_MODE=fixed_admin
ADMIN_PASSWORD=change-me-min-8-chars

# Fase 2 multi_user: verificação por e-mail
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# Fase 1: criação custom via wizard desligada (pregens + starter ativos)
ENABLE_CUSTOM_CHARGEN=false

# Ambiente: development (local) | production (deploy)
APP_ENV=development

# Frontend — copie para frontend/.env.local
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_CUSTOM_CHARGEN=false
NEXT_PUBLIC_API_URL=http://localhost:8000
