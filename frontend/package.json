{
  "name": "wfrp-solo-frontend",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "npx tsx --test src/lib/**/*.test.ts",
    "prepare:dice": "mkdir -p public/assets/dice-box && cp -r node_modules/@3d-dice/dice-box/dist/* public/assets/dice-box/",
    "prepare:audio": "mkdir -p public/audio && cp ../audio/*.mp3 public/audio/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@types/three": "^0.184.1",
    "cannon-es": "^0.20.0",
    "next": "14.2.35",
    "next-intl": "^3.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
